# AI DevOps Kubernetes Agent - Environment Configuration

# Project & Environment
PROJECT_NAME=ai-kubernetes-agent
ENVIRONMENT=development

# AWS Region & Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Bedrock Configuration
# Set any Bedrock model available in your AWS account (e.g. qwen.qwen3-coder-next, anthropic.claude-3-5-sonnet-20240620-v1:0, amazon.titan-text-express-v1)
AWS_BEDROCK_MODEL_ID=qwen.qwen3-coder-next

# AWS DynamoDB Table Name for Investigation History
AWS_DYNAMODB_TABLE=k8s_investigation_history

# Secondary / Fallback OpenRouter API (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder-next
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kubernetes Kubeconfig Path
KUBECONFIG_PATH=~/.kube/config
