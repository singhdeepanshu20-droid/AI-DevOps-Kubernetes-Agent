# AI DevOps Kubernetes Agent - Environment Configuration

# Project Settings
PROJECT_NAME=ai-kubernetes-agent
ENVIRONMENT=development

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS Bedrock Model ID (Specify any AI Model ID supported by your AWS account)
AWS_BEDROCK_MODEL_ID=qwen.qwen3-coder-next

# AWS DynamoDB Table
AWS_DYNAMODB_TABLE=k8s_investigation_history

# OpenRouter Fallback (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-coder-next

# Local Kubernetes Configuration
KUBECONFIG_PATH=~/.kube/config
